NODE_ENV=production
APP_ORIGIN=https://YOUR-APP-DOMAIN
APP_DB=/data/app.sqlite
PORT=8788
# Random secret at least 32 characters; remove after first account creation.
ADMIN_SETUP_TOKEN=
# Server secrets only, never paste into chat or client code.
RESEND_API_KEY=
MAIL_FROM=برنامه جامع <noreply@YOUR-VERIFIED-DOMAIN>
# An independent backup destination is required before real use.
BACKUP_DIR=/backup
